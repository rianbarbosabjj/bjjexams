{
  "hosting": {
    "site": "bjj-exams-staging",
    "public": ".firebase-hosting-staging",
    "ignore": [
      "firebase-debug.log",
      "firebase-debug.*.log"
    ],
    "trailingSlash": false,
    "headers": [
      {
        "source": "**/*.html",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-store, max-age=0"
          }
        ]
      },
      {
        "source": "**/*.js",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, max-age=0"
          }
        ]
      }
    ]
  }
}